    "package:mac": "tauri build",
    "package:universal": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "docx": "^9.5.1",
    "fast-xml-parser": "^5.12.0",
